  m_Script: {fileID: 11500000, guid: 4dccb809720725249a6e2bece6f1fe7e, type: 3}
  m_Name: 1 Primer dialogo
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "\"\xA1Hola, peque\xF1o aventurero! Bienvenido a un mundo lleno de historias
      y sorpresas.\""
  - text: "\"Por desgracia, el lugar est\xE1 en obras y ahora mismo no hay mucho
      que hacer por aqu\xED.\""
  - text: "\"Pero puedo ofrecerte dos retos. \xBFCu\xE1l quieres probar primero?\""
  dialogueID: 0
