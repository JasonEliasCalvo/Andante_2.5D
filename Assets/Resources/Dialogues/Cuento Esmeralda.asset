  m_Script: {fileID: 11500000, guid: 4dccb809720725249a6e2bece6f1fe7e, type: 3}
  m_Name: Cuento Esmeralda
  m_EditorClassIdentifier: 
  dialogueLines:
  - text: "En un rinc\xF3n olvidado de un libro de cuentos, viv\xEDa un colibr\xED
      de plumas como joyas verdes."
  - text: "Cada noche volaba entre p\xE1ginas, cruzando mundos."
  - text: "Pero no quer\xEDa quedarse. Dec\xEDa que los libros eran jaulas hermosas\u2026
      para mentes curiosas. "
  - text: "Pero no quer\xEDa quedarse. Dec\xEDa que los libros eran jaulas hermosas\u2026
      para mentes curiosas. "
  - text: "Un d\xEDa encontr\xF3 una vieja y desgastada nota escondida:"
  - text: "Desde entonces, no solo vol\xF3: estudi\xF3, gui\xF3\u2026 y compiti\xF3."
  - text: "Porque seg\xFAn la vieja nota, solo uno pod\xEDa salir."
  - text: "Y Esmeralda estaba decidida a que ser\xEDa ella"
  dialogueID: 0
