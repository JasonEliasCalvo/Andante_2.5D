  m_Script: {fileID: 11500000, guid: d3f3a1fedaaba3b4faf8abec2819d9e7, type: 3}
  m_Name: Tutorial dialogue
  m_EditorClassIdentifier: 
  dialogueLines:
  - "Bienvenido al Reino de los Sue\xF1os. Usa el clic izquierdo del rat\xF3n o la
    tecla F para avanzar los di\xE1logos.\n"
  - "Con Q puedes saltarte todo el di\xE1logo."
  - "Mmm\u2026 sigues aqu\xED. Entonces, d\xE9jame darte una pista."
  - "Algunos objetos van al inventario si los tocas, como la imagen que est\xE1 frente
    a ti.\n\n"
  dialogueID: 10
