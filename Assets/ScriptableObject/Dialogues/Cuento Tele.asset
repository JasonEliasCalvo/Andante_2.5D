  m_Script: {fileID: 11500000, guid: d3f3a1fedaaba3b4faf8abec2819d9e7, type: 3}
  m_Name: Cuento Tele
  m_EditorClassIdentifier: 
  dialogueLines:
  - 'Dicen que hay un televisor sin botones ni antena.

'
  - "No muestra programas ni dibujos\u2026\n"
  - Muestra recuerdos.
  - 'Cuando alguien lo toca, se enciende solo.

'
  - 'Pero cuidado: si parpadeas, olvidas lo que viste.'
  - "Si logras recordarlo todo, el televisor sonr\xEDe y te premia.\n"
  - "Si no\u2026 te hace empezar otra vez."
  dialogueID: 15
