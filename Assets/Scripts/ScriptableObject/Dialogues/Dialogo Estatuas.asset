  m_Script: {fileID: 11500000, guid: d3f3a1fedaaba3b4faf8abec2819d9e7, type: 3}
  m_Name: Dialogo Estatuas
  m_EditorClassIdentifier: 
  dialogueLines:
  - "\xA1Hola! Qu\xE9 alegr\xEDa verte. Alguien movi\xF3 las estatuas antiguas y
    ahora est\xE1n fuera de su lugar. Son muy importantes para la isla."
  - "\xBFPuedes ayudarme a ponerlas en su sitio? Solo f\xEDjate en la base de piedra
    que le corresponde a cada una. \xA1Gracias por tu ayuda!"
  dialogueID: 3
